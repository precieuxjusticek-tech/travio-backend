app.post('/agence/:agenceId/abonnement', async (req, res) => {
  const { agenceId } = req.params;
  const { dureeMois } = req.body;

  if (![3, 6, 9, 12].includes(Number(dureeMois))) {
    return res.status(400).json({ message: 'Durée invalide. Choisissez 3, 6, 9 ou 12 mois.' });
  }

  try {
    const docRef = firestore.collection('agences').doc(agenceId);
    const doc = await docRef.get();
    if (!doc.exists) return res.status(404).json({ message: 'Agence introuvable.' });

    const agence = doc.data();

    // ── Bloquer si déjà actif avec encore du temps devant soi ──
    const abo = agence.abonnement;
    const encoreActif = abo?.statut === 'actif' && abo?.dateExpiration && new Date(abo.dateExpiration) > new Date();
    const joursRestants = encoreActif ? Math.ceil((new Date(abo.dateExpiration) - new Date()) / (1000 * 60 * 60 * 24)) : 0;

    if (encoreActif && joursRestants > 7) {
      return res.status(409).json({
        message: `Votre abonnement est encore actif pour ${joursRestants} jours. Vous pourrez renouveler à partir de 7 jours avant l'échéance.`,
      });
    }

    const pdvSnap = await firestore.collection('pointsDeVente')
      .where('agenceId', '==', agenceId)
      .where('actif', '==', true)
      .get();
    const nbPdvSupp = Math.max(0, pdvSnap.size - PDV_INCLUS);

    const calcul = calculerAbonnement(agence.tarifPilote === true, Number(dureeMois), nbPdvSupp);

    const demandes = agence.abonnement?.demandes || [];
    demandes.push({ date: new Date().toISOString(), dureeMois: Number(dureeMois) });

    await docRef.update({
      'abonnement.statut': 'en_attente_validation',
      'abonnement.formule': agence.tarifPilote ? 'pilote' : 'standard',
      'abonnement.dureeMois': Number(dureeMois),
      'abonnement.montantMensuel': calcul.montantMensuel,
      'abonnement.montantTotal': calcul.montantTotal,
      'abonnement.reductionPct': calcul.reductionPct,
      'abonnement.demandeAt': new Date().toISOString(),
      'abonnement.demandes': demandes,
      'abonnement.pdvActifs': pdvSnap.size,
      'abonnement.nbPdvSupp': nbPdvSupp,
    });

    return res.status(200).json({ message: 'Demande enregistrée, en attente de validation.', calcul });
  } catch (err) {
    console.error('Erreur demande abonnement :', err);
    return res.status(500).json({ message: 'Erreur serveur.' });
  }
});

