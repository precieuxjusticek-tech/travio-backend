// ════════════════════════════════
//  INSCRIPTION
//  POST /auth/register
//  Body : { prenom, nom, email, password }
// ════════════════════════════════
app.post('/auth/register', async (req, res) => {
  const { prenom, nom, email, password } = req.body;

  // Vérification des champs
  if (!prenom || !nom || !email || !password) {
    return res.status(400).json({ message: 'Tous les champs sont obligatoires.' });
  }

  try {
    // 1. Créer l'utilisateur dans Firebase Auth
    const userRecord = await auth.createUser({
      email,
      password,
      displayName: `${prenom} ${nom}`,
    });

    // 2. Sauvegarder ses infos dans Firestore
    await firestore.collection('users').doc(userRecord.uid).set({
      prenom,
      nom,
      email,
      role: 'admin',         // c'est le fondateur de l'agence
      agenceId: null,
      createdAt: new Date().toISOString(),
    });

    return res.status(201).json({
      message: 'Compte créé avec succès.',
      uid: userRecord.uid,
    });

  } catch (error) {
    // Email déjà utilisé
    if (error.code === 'auth/email-already-exists') {
      return res.status(409).json({ message: 'Cet email est déjà utilisé.' });
    }
    // Mot de passe trop faible
    if (error.code === 'auth/weak-password') {
      return res.status(400).json({ message: 'Le mot de passe doit faire au moins 6 caractères.' });
    }
    console.error('Erreur inscription :', error);
    return res.status(500).json({ message: 'Erreur serveur, réessayez.' });
  }
});

// ════════════════════════════════
//  CONNEXION
//  POST /auth/login
//  Body : { email, password }
//  Note : Firebase Auth gère la connexion côté client.
//  Ce endpoint vérifie juste que l'utilisateur existe
//  et renvoie ses infos Firestore (rôle, agenceId, etc.)
// ════════════════════════════════
app.post('/auth/login', async (req, res) => {
  const { email } = req.body;

  if (!email) {
    return res.status(400).json({ message: 'Email manquant.' });
  }

  try {
    // Récupérer l'utilisateur par email
    const userRecord = await auth.getUserByEmail(email);

    // Récupérer ses infos dans Firestore
    const userDoc = await firestore.collection('users').doc(userRecord.uid).get();

    if (!userDoc.exists) {
      return res.status(404).json({ message: 'Utilisateur introuvable.' });
    }

    const userData = userDoc.data();

    return res.status(200).json({
      message:  'Connexion réussie.',
      uid:      userRecord.uid,
      prenom:   userData.prenom,
      nom:      userData.nom,
      role:     userData.role,
      agenceId: userData.agenceId,
      pdvId:    userData.pdvId || null,
    });

  } catch (error) {
    if (error.code === 'auth/user-not-found') {
      return res.status(404).json({ message: 'Aucun compte trouvé avec cet email.' });
    }
    console.error('Erreur connexion :', error);
    return res.status(500).json({ message: 'Erreur serveur, réessayez.' });
  }
});

const checkAbonnement = async (req, res, next) => {
  const agenceId = req.query.agenceId || req.body.agenceId || req.params.agenceId;
  if (!agenceId) return next();
  try {
    const doc = await firestore.collection('agences').doc(agenceId).get();
    if (!doc.exists) return res.status(404).json({ message: 'Agence introuvable.' });
    const abo = doc.data().abonnement;
    if (!abo || abo.statut !== 'actif') {
      return res.status(403).json({ message: 'Abonnement inactif.', code: 'ABONNEMENT_INACTIF' });
    }
    if (abo.dateExpiration && new Date(abo.dateExpiration) < new Date()) {
      await firestore.collection('agences').doc(agenceId).update({ 'abonnement.statut': 'expiré' });
      return res.status(403).json({ message: 'Abonnement expiré.', code: 'ABONNEMENT_EXPIRE' });
    }
    next();
  } catch (err) {
    return res.status(500).json({ message: 'Erreur vérification abonnement.' });
  }
};

// ════════════════════════════════
//  MOT DE PASSE OUBLIÉ
//  POST /auth/forgot-password
//  Body : { email }
//  Note : Firebase envoie l'email de reset automatiquement
// ════════════════════════════════
app.post('/auth/forgot-password', async (req, res) => {
  const { email } = req.body;

  if (!email) {
    return res.status(400).json({ message: 'Email manquant.' });
  }

  try {
    // Vérifier que l'utilisateur existe
    await auth.getUserByEmail(email);

    // Le vrai envoi d'email se fait côté client avec Firebase SDK
    // Ce endpoint confirme juste que l'email est valide
    return res.status(200).json({
      message: 'Email vérifié. Envoi du lien en cours.',
    });

  } catch (error) {
    if (error.code === 'auth/user-not-found') {
      // On ne révèle pas si l'email existe ou non (sécurité)
      return res.status(200).json({
        message: 'Si cet email existe, un lien vous sera envoyé.',
      });
    }
    console.error('Erreur forgot password :', error);
    return res.status(500).json({ message: 'Erreur serveur, réessayez.' });
  }
});

