// ════════════════════════════════
//  ADMIN — RENOUVELER / ENCAISSER UN PAIEMENT
//  POST /admin/agence/:agenceId/renouveler
//  Body : { adminKey, montantRecu, validateurNom }
// ════════════════════════════════
app.post('/admin/agence/:agenceId/renouveler', async (req, res) => {
  const { agenceId } = req.params;
  const { adminKey, montantRecu, validateurNom } = req.body;

  if (adminKey !== process.env.ADMIN_SECRET_KEY) {
    return res.status(403).json({ message: 'Non autorisé.' });
  }

  const { dureeMois } = req.body;
  if (!montantRecu || !validateurNom || ![3, 6, 9, 12].includes(Number(dureeMois))) {
    return res.status(400).json({ message: 'Montant, validateur et durée (3/6/9/12) obligatoires.' });
  }

  try {
    const docRef = firestore.collection('agences').doc(agenceId);
    const doc = await docRef.get();
    if (!doc.exists) return res.status(404).json({ message: 'Agence introuvable.' });

    const agence = doc.data();
    const abo = agence.abonnement || {};

    // Même garde-fou que côté client : pas de renouvellement anticipé
    // de plus de 7 jours (sauf expiré / jamais activé / en attente).
    const exp = abo.dateExpiration ? new Date(abo.dateExpiration) : null;
    const encoreActif = abo.statut === 'actif' && exp && exp > new Date();
    const joursRestants = encoreActif
      ? Math.ceil((exp - new Date()) / (1000 * 60 * 60 * 24))
      : 0;

    if (encoreActif && joursRestants > 7) {
      return res.status(409).json({
        message: `Cette agence a encore ${joursRestants} jours restants. Renouvellement possible à partir de 7 jours avant l'échéance.`,
      });
    }

    const baseDate = (exp && exp > new Date()) ? exp : new Date();
    const nouvelleExpiration = new Date(baseDate);
    nouvelleExpiration.setMonth(nouvelleExpiration.getMonth() + Number(dureeMois));

    const paiements = abo.paiements || [];
    paiements.push({
      montant: Number(montantRecu),
      date: new Date().toISOString(),
      statut: 'paye',
      validateurNom,
    });

    const montantMensuelCalcule = Math.round(Number(montantRecu) / Number(dureeMois));

    await docRef.update({
      'abonnement.statut': 'actif',
      'abonnement.dateExpiration': nouvelleExpiration.toISOString(),
      'abonnement.dateActivation': new Date().toISOString(),
      'abonnement.dureeMois': Number(dureeMois),
      'abonnement.montantMensuel': montantMensuelCalcule,
      'abonnement.montantTotal': Number(montantRecu),
      'abonnement.paiements': paiements,
      'abonnement.demandes': [],
    });

    return res.status(200).json({
      message: 'Renouvellement enregistré.',
      dateExpiration: nouvelleExpiration.toISOString(),
    });
  } catch (err) {
    console.error('Erreur renouvellement admin :', err);
    return res.status(500).json({ message: 'Erreur serveur.' });
  }
});

// ── Tarification Travio ──
const TARIF_PILOTE      = 25000;   // City Bus et futurs partenaires pilotes
const TARIF_STANDARD    = 50000;   // nouvelles agences
const PDV_INCLUS        = 6;
const PRIX_PDV_SUPP     = 5000;
const REDUCTIONS_DUREE  = { 3: 0.05, 6: 0.08, 9: 0.10, 12: 0.12 };

// Calcule le prix mensuel effectif + le total selon le tarif de l'agence et la durée choisie
function calculerAbonnement(tarifPilote, dureeMois, nbPdvSupp = 0) {
  const prixBase = tarifPilote ? TARIF_PILOTE : TARIF_STANDARD;
  const supplementPdv = nbPdvSupp * PRIX_PDV_SUPP;
  const reductionPct = REDUCTIONS_DUREE[dureeMois] || 0;

  const prixBaseReduit = Math.round(prixBase * (1 - reductionPct));
  const montantMensuel = prixBaseReduit + supplementPdv; // ← PDV supp non réduit
  const montantTotal = montantMensuel * dureeMois;
  const economie = (prixBase - prixBaseReduit) * dureeMois; // ← économie uniquement sur la base

  return { base: prixBase, supplementPdv, reductionPct, montantMensuel, montantTotal, economie };
}

